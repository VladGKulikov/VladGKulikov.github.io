  "datasets": {
    "en": {
      "documents": [
        {
          "document_id": "d00",
          "source_id": "ann",
          "text": "HNSW builds a multi-layer small-world graph for approximate nearest-neighbor search over vectors."
        },
        {
          "document_id": "d01",
          "source_id": "ann",
          "text": "IVF PQ partitions vectors into clusters and quantizes residuals, reducing index memory for hundreds of millions of objects."
        },
        {
          "document_id": "d02",
          "source_id": "hybrid",
          "text": "Reciprocal rank fusion RRF combines BM25 and dense-search rankings without calibrating their scores."
        },
        {
          "document_id": "d03",
          "source_id": "sparse",
          "text": "BM25 uses term frequency, inverse document frequency, and document-length normalization."
        },
        {
          "document_id": "d04",
          "source_id": "dense",
          "text": "A dense bi encoder encodes the query and document independently as vectors and compares them with cosine similarity."
        },
        {
          "document_id": "d05",
          "source_id": "rerank",
          "text": "A cross encoder reads the query and document jointly and scores relevance more accurately, but needs a separate forward pass for every pair."
        },
        {
          "document_id": "d06",
          "source_id": "chunking",
          "text": "Overlap between adjacent chunks preserves local context at a document boundary."
        },
        {
          "document_id": "d07",
          "source_id": "chunking",
          "text": "Late chunking first encodes the long document as a whole, so pronouns and anaphora retain context after splitting."
        },
        {
          "document_id": "d08",
          "source_id": "routing",
          "text": "Long context places the entire long document in the prompt and suits holistic analysis of one file."
        },
        {
          "document_id": "d09",
          "source_id": "rag",
          "text": "RAG retrieves relevant corpus passages, assembles a cited context, and sends it to the generator."
        },
        {
          "document_id": "d10",
          "source_id": "metrics",
          "text": "nDCG supports graded relevance and applies a logarithmic discount to lower ranks."
        },
        {
          "document_id": "d11",
          "source_id": "metrics",
          "text": "MRR measures the reciprocal rank of the first relevant result and ignores additional relevant documents."
        },
        {
          "document_id": "d12",
          "source_id": "packing",
          "text": "Context packing removes duplicates, respects a token budget, and preserves source citations."
        }
      ],
      "queries": [
        {
          "query_id": "q0",
          "relevance": {
            "d02": 3,
            "d09": 1
          },
          "text": "how to merge bm25 and dense results"
        },
        {
          "query_id": "q1",
          "relevance": {
            "d00": 3,
            "d01": 1
          },
          "text": "a graph for approximate nearest neighbor search"
        },
        {
          "query_id": "q2",
          "relevance": {
            "d10": 1,
            "d11": 3
          },
          "text": "position of the first useful result"
        },
        {
          "query_id": "q3",
          "relevance": {
            "d06": 2,
            "d07": 3
          },
          "text": "preserve anaphora after splitting a document"
        },
        {
          "query_id": "q4",
          "relevance": {
            "d04": 1,
            "d05": 3
          },
          "text": "why a cross encoder cannot score the whole corpus"
        },
        {
          "query_id": "q5",
          "relevance": {
            "d08": 3,
            "d09": 2
          },
          "text": "when to read the whole long file instead of retrieval"
        },
        {
          "query_id": "q6",
          "relevance": {
            "d09": 2,
            "d12": 3
          },
          "text": "pack retrieved passages with citations into a token limit"
        }
      ]
    },
    "ru": {
      "documents": [
        {
          "document_id": "d00",
          "source_id": "ann",
          "text": "HNSW строит многослойный граф малого мира для приближённого поиска ближайших соседей среди векторов."
        },
        {
          "document_id": "d01",
          "source_id": "ann",
          "text": "IVF PQ делит векторы на кластеры и кодирует остатки, уменьшая память индекса для сотен миллионов объектов."
        },
        {
          "document_id": "d02",
          "source_id": "hybrid",
          "text": "Reciprocal rank fusion RRF объединяет ранги BM25 и dense поиска без калибровки их оценок."
        },
        {
          "document_id": "d03",
          "source_id": "sparse",
          "text": "BM25 использует частоту терма, обратную документную частоту и нормировку длины документа."
        },
        {
          "document_id": "d04",
          "source_id": "dense",
          "text": "Dense bi encoder независимо кодирует запрос и документ в векторы, после чего сравнивает их косинусом."
        },
        {
          "document_id": "d05",
          "source_id": "rerank",
          "text": "Cross encoder совместно читает запрос и документ и точнее оценивает релевантность, но требует отдельного прохода на каждую пару."
        },
        {
          "document_id": "d06",
          "source_id": "chunking",
          "text": "Overlap между соседними чанками сохраняет локальный контекст на границе разбиения документа."
        },
        {
          "document_id": "d07",
          "source_id": "chunking",
          "text": "Late chunking сначала кодирует длинный документ целиком, поэтому местоимения и анафоры сохраняют контекст после нарезки."
        },
        {
          "document_id": "d08",
          "source_id": "routing",
          "text": "Long context помещает целый длинный документ в промпт и подходит для целостного анализа одного файла."
        },
        {
          "document_id": "d09",
          "source_id": "rag",
          "text": "RAG извлекает релевантные фрагменты корпуса, собирает контекст с цитатами и передаёт его генератору."
        },
        {
          "document_id": "d10",
          "source_id": "metrics",
          "text": "nDCG учитывает градуированную релевантность и логарифмически штрафует низкие позиции."
        },
        {
          "document_id": "d11",
          "source_id": "metrics",
          "text": "MRR измеряет обратный ранг первого релевантного результата и игнорирует остальные найденные документы."
        },
        {
          "document_id": "d12",
          "source_id": "packing",
          "text": "Context packing удаляет дубликаты, соблюдает токенный бюджет и сохраняет ссылки на источники."
        }
      ],
      "queries": [
        {
          "query_id": "q0",
          "relevance": {
            "d02": 3,
            "d09": 1
          },
          "text": "как слить результаты bm25 и dense"
        },
        {
          "query_id": "q1",
          "relevance": {
            "d00": 3,
            "d01": 1
          },
          "text": "граф соседей для approximate nearest neighbor"
        },
        {
          "query_id": "q2",
          "relevance": {
            "d10": 1,
            "d11": 3
          },
          "text": "позиция первого полезного результата"
        },
        {
          "query_id": "q3",
          "relevance": {
            "d06": 2,
            "d07": 3
          },
          "text": "как сохранить анафоры после нарезки документа"
        },
        {
          "query_id": "q4",
          "relevance": {
            "d04": 1,
            "d05": 3
          },
          "text": "почему cross encoder нельзя запустить на всём корпусе"
        },
        {
          "query_id": "q5",
          "relevance": {
            "d08": 3,
            "d09": 2
          },
          "text": "когда лучше прочитать весь длинный файл вместо retrieval"
        },
        {
          "query_id": "q6",
          "relevance": {
            "d09": 2,
            "d12": 3
          },
          "text": "context packing: как собрать найденные фрагменты с цитатами в лимит токенов"
        }
      ]
    }
  },
